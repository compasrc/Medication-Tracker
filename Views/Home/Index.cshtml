@{
    ViewData["Title"] = "Home";
}

<div class="simple-card">
    <h1 class="page-title">Welcome to Medication Tracker</h1>
    <p class="page-subtitle">
        Keep track of medications, schedules, and possible interactions in one place.
    </p>

    <a class="button-main" asp-controller="Medication" asp-action="Create">Add Medication</a>
</div>

<div class="simple-card">
    <h2>Today's Summary</h2>
    <p><strong>Taken:</strong> 0</p>
    <p><strong>Missed:</strong> 0</p>
    <p><strong>Remaining:</strong> 4</p>
    <p><strong>Adherence:</strong> 100%</p>
</div>