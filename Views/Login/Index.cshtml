@model Medication_Tracker.Models.User
@{
    ViewData["Title"] = "Login";
}

<div class="login-wrapper">
    <div class="login-card">
    <h1 class="page-title">Welcome to Medication Tracker</h1>

    <p class="subtitle">
        Please log in or <a href="/SignUp">sign up</a> to continue.
    </p>

    <form asp-action="Login" method="post" class="login-form">

		<div asp-validation-summary="All" class="error"></div>

        <div class="form-group"> 
            <label asp-for=Username></label>
            <input type="text" asp-for="Username" class="form-input" />
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input type="password" asp-for="Password" class="form-input" />
        </div>

        <button type="submit" class="button-main">Login</button>

        <p class="error">@ViewBag.Error</p>
    </form>

    <p class="signup-text">
        Don’t have an account?
        <a href="/SignUp">Create one</a>
    </p>
    </div>
</div>