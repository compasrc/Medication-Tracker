@model Medication_Tracker.Models.Medication

@{
    ViewData["Title"] = "Add Medication";
}

<div class="simple-card">
    <h1 class="page-title">Add Medication</h1>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <label asp-for="Name">Medication Name</label>
        <input asp-for="Name" class="form-input" placeholder="Enter medication name" />
        <span asp-validation-for="Name" class="error"></span>

        <label asp-for="Dosage"></label>
        <input asp-for="Dosage" class="form-input" placeholder="Enter dosage" />
        <span asp-validation-for="Dosage" class="error"></span>

        <label asp-for="Frequency"></label>
        <select asp-for="Frequency" class="form-select" id="frequencySelect">
            <option value="">Select frequency</option>
            <option value="Once daily">Once daily</option>
            <option value="Twice daily">Twice daily</option>
            <option value="Every 8 hours">Every 8 hours</option>
            <option value="As needed">As needed</option>
        </select>
        <span asp-validation-for="Frequency" class="error"></span>

        <div id="timingFields">
            <label asp-for="TimeToTake">Time</label>
            <input asp-for="TimeToTake" type="time" class="form-input" id="timeToTakeInput" />
            <span asp-validation-for="TimeToTake" class="error"></span>

            <label for="scheduleTimes">Times (comma separated)</label>
            <input type="text" name="scheduleTimes" id="scheduleTimesInput" class="form-input" placeholder="06:00, 14:00, 22:00" />
        </div>

        <label asp-for="Description">Notes</label>
        <textarea asp-for="Description" class="form-textarea" rows="4" placeholder="Optional notes"></textarea>
        <span asp-validation-for="Description" class="error"></span>

        <button class="button-main" type="submit">Save Medication</button>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const frequencySelect = document.getElementById('frequencySelect');
            const timingFields = document.getElementById('timingFields');
            const timeInput = document.getElementById('timeToTakeInput');
            const scheduleTimesInput = document.getElementById('scheduleTimesInput');

            function toggleTimingFields() {
                const isAsNeeded = frequencySelect.value === 'As needed';
                timingFields.style.display = isAsNeeded ? 'none' : 'block';
                if (isAsNeeded) {
                    timeInput.value = '';
                    scheduleTimesInput.value = '';
                }
            }

            frequencySelect.addEventListener('change', toggleTimingFields);
            toggleTimingFields();
        });
    </script>
}