@model Medication_Tracker.Models.Medication

@{
    ViewData["Title"] = "Add Medication";
}

<div class="form-wrapper">
    <div class="form-card">
        <h1>Add Medication</h1>
        <p class="form-subtitle">Enter medication details and schedule times.</p>

        <form asp-action="Create" method="post" autocomplete="off">

            <div class="form-group">
                <label asp-for="Name">Medication Name</label>
                <input asp-for="Name" class="form-input" placeholder="Enter medication name" />
                <div id="suggestions" class="suggestions-box"></div>
            </div>

            <div class="form-group">
                <label asp-for="Dosage">Dosage</label>
                <input asp-for="Dosage" class="form-input" placeholder="Enter dosage" />
            </div>

            <div class="form-group">
                <label asp-for="Frequency">Frequency</label>
                <select asp-for="Frequency" class="form-input">
                    <option value="">Select frequency</option>
                    <option>Once daily</option>
                    <option>Twice daily</option>
                    <option>Three times daily</option>
                    <option>As needed</option>
                </select>
            </div>

            <div class="form-group">
                <label>Time</label>
                <input type="time" name="TimeToTake" class="form-input" />
            </div>

            <div class="form-group">
                <label>Times (comma separated)</label>
                <input type="text" name="Times" class="form-input" placeholder="06:00, 14:00, 22:00" />
            </div>

            <div class="form-group">
                <label>Notes</label>
                <textarea name="Notes" class="form-input notes-box" placeholder="Optional notes"></textarea>
            </div>

            <button type="submit" class="save-btn">Save Medication</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('Name');
            const box = document.getElementById('suggestions');
            const endpoint = '@Url.Action("SideEffectsSuggestions", "Medication")';

            let timer = null;
            let currentController = null;
            const localCache = new Map();

            function clearSuggestions() {
                box.innerHTML = '';
                box.style.display = 'none';
            }

            function renderSuggestions(items) {
                if (!items || items.length === 0) return clearSuggestions();

                box.innerHTML = '';

                items.forEach(name => {
                    const row = document.createElement('div');
                    row.textContent = name;
                    row.className = 'suggestion-item';
                    row.onclick = () => {
                        input.value = name;
                        clearSuggestions();
                    };
                    box.appendChild(row);
                });

                box.style.display = 'block';
            }

            input.addEventListener('input', function () {
                const q = input.value.trim();

                if (q.length < 3) return clearSuggestions();

                const key = q.toLowerCase();

                if (localCache.has(key)) {
                    return renderSuggestions(localCache.get(key));
                }

                if (timer) clearTimeout(timer);

                timer = setTimeout(async () => {
                    if (currentController) currentController.abort();
                    currentController = new AbortController();

                    try {
                        const res = await fetch(`${endpoint}?term=${encodeURIComponent(q)}`, {
                            signal: currentController.signal
                        });

                        if (!res.ok) return clearSuggestions();

                        const data = await res.json();
                        localCache.set(key, data);
                        renderSuggestions(data);
                    } catch {
                        clearSuggestions();
                    }
                }, 180);
            });

            document.addEventListener('click', function (e) {
                if (!input.contains(e.target) && !box.contains(e.target)) {
                    clearSuggestions();
                }
            });
        });
    </script>
}