@model Medication_Tracker.Models.Medication

@{
    ViewData["Title"] = "Edit Medication";
    var existingTimes = ViewBag.ScheduleTimes as string ?? "";
}

<div class="simple-card">
    <h1 class="page-title">Edit Medication</h1>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <label asp-for="Name">Medication Name</label>
        <input asp-for="Name" class="form-input" />
        <span asp-validation-for="Name" class="error"></span>

        <label asp-for="Dosage"></label>
        <input asp-for="Dosage" class="form-input" />
        <span asp-validation-for="Dosage" class="error"></span>

        <label asp-for="Frequency"></label>
        <select asp-for="Frequency" class="form-select">
            <option value="">Select frequency</option>
            <option value="Once daily">Once daily</option>
            <option value="Twice daily">Twice daily</option>
            <option value="Every 8 hours">Every 8 hours</option>
            <option value="As needed">As needed</option>
        </select>
        <span asp-validation-for="Frequency" class="error"></span>

        <label for="scheduleTimes">Times (comma separated)</label>
        <input type="text" name="scheduleTimes" value="@existingTimes" class="form-input" placeholder="06:00, 14:00, 22:00" />

        <label asp-for="Description">Notes</label>
        <textarea asp-for="Description" class="form-textarea" rows="4"></textarea>
        <span asp-validation-for="Description" class="error"></span>

        <button class="button-main" type="submit">Save Changes</button>
        <a asp-action="Index" style="margin-left: 10px;">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}