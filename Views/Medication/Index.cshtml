@model List<Medication_Tracker.Models.Medication>

@{
    ViewData["Title"] = "Medications";
    var schedules = ViewBag.ScheduleTimes as List<Medication_Tracker.Models.MedicationSchedule>;
}

<div class="med-page">
    <div class="med-header">
        <div>
            <h1>Medications</h1>
            <p>Your current medication list.</p>
        </div>

        <a class="dashboard-btn" asp-controller="Medication" asp-action="Create">
            Add Medication
        </a>
    </div>

    <div class="med-grid">
        @foreach (var med in Model)
        {
            var medTimes = schedules?
                .Where(s => s.MedicationId == med.Id)
                .Select(s => s.ScheduleTime)
                .ToList();

            <div class="med-list-card">
                <h2>@med.Name</h2>

                <p><strong>Dosage:</strong> @med.Dosage</p>
                <p><strong>Frequency:</strong> @med.Frequency</p>

                @if (!string.IsNullOrWhiteSpace(med.Description))
                {
                    <p><strong>Notes:</strong> @med.Description</p>
                }

                @if (medTimes != null && medTimes.Any())
                {
                    <p><strong>Times:</strong> @string.Join(", ", medTimes)</p>
                }

                <div class="med-actions">
                    <a asp-controller="Medication" asp-action="Edit" asp-route-id="@med.Id">Edit</a>
                    <a class="delete-link" asp-controller="Medication" asp-action="Delete" asp-route-id="@med.Id">Delete</a>
                </div>
            </div>
        }
    </div>
</div>