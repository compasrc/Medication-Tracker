<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <div class="container nav-wrapper">
            <a class="logo" asp-controller="Home" asp-action="Index">MedTracker</a>

            @using Microsoft.AspNetCore.Http

<nav class="main-nav">
                @if (Context.Session.GetString("User") != null)
                {
                    <span style="margin-right:10px;">
                        Welcome, @Context.Session.GetString("User")
                    </span>
 
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Medication" asp-action="Index">Medications</a>
                    <a asp-controller="Medication" asp-action="Create">Add Medication</a>
                    <a asp-controller="Medication" asp-action="Interactions">Interactions</a>

                    <a asp-controller="Login" asp-action="Logout">Logout</a>
                }
                else
                {
                    <a asp-controller="Login" asp-action="Index">Login</a>
                    <a asp-controller="SignUp" asp-action="Index">Sign Up</a>
                }
            </nav>
        </div>
    </header>

    <main class="container page-section">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>