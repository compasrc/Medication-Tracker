@model Medication_Tracker.Models.User

@{
    ViewData["Title"] = "Sign Up";
}

<div class="simple-card">
    <h1 class="page-title">Create Account</h1>

    @if (ViewBag.Error != null)
    {
        <p class="error">@ViewBag.Error</p>
    }

    <form asp-action="Index" method="post" class="login-form">
        <div class="form-group">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-input" />
            <span asp-validation-for="FirstName" class="error"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" class="form-input" />
            <span asp-validation-for="LastName" class="error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-input" />
            <span asp-validation-for="Email" class="error"></span>
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber"></label>
            <input asp-for="PhoneNumber" class="form-input" />
            <span asp-validation-for="PhoneNumber" class="error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="form-input" />
            <span asp-validation-for="Username" class="error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" class="form-input" />
            <span asp-validation-for="Password" class="error"></span>
        </div>

        <button type="submit" class="button-main">Sign Up</button>
    </form>

    <p class="signup-text">
        Already have an account?
        <a asp-controller="Login" asp-action="Index">Log in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}